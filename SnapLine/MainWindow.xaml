<Window
    x:Class="SnapLine.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="SnapLine">
    <Grid x:Name="ClotheslineRoot" Background="Transparent" Opacity="1">
        <Path Data="M 0,0 Q 1,26 2,0" Margin="24,19,24,0" Height="28" VerticalAlignment="Top" Stretch="Fill" Stroke="#A99B83" StrokeThickness="2" IsHitTestVisible="False" />
        <ScrollViewer Margin="12,22,12,0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{x:Bind Clothesline.Items}">
            <ItemsControl.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <ReorderThemeTransition />
                </TransitionCollection>
            </ItemsControl.ItemContainerTransitions>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Width="144" Height="176"
                          CanDrag="True"
                          DragStarting="OnScreenshotDragStarting"
                          DropCompleted="OnScreenshotDropCompleted"
                          Tapped="OnScreenshotTapped"
                          ContextRequested="OnScreenshotContextRequested"
                          ToolTipService.ToolTip="Click to open · drag to share">
                        <Line X1="72" Y1="0" X2="72" Y2="20" Stroke="#A99B83" StrokeThickness="2" />
                        <Border Margin="7,18,7,12" Padding="4" CornerRadius="9" Background="#F4F0E8" BorderBrush="#D4C7B2" BorderThickness="1">
                            <Grid>
                                <Image Source="{Binding ThumbnailImage}" Stretch="UniformToFill" />
                                <Border Height="22" VerticalAlignment="Bottom" Background="#66000000">
                                    <TextBlock Text="{Binding CreatedAtLabel}" Foreground="White" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
